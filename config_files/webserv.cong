server {
    listen 127.0.0.1:8080;
    location /old {
        return 301 /leen;
    }
    location /google {
        return 302 http://www.google.com;
    }

    location /error {
        return 520;
    }

    location / {
        root ./www;
        index index.html;
        methods GET;
    }
}