server {
    listen 127.0.0.1:8080;
    server_name test.com;

    client_max_body_size 1000000;

    error_page 404 /errors/404.html;
    error_page 500 /errors/500.html;

    # MAIN WEBSITE
    location / {
        root ./www;
        index index.html;
        methods GET POST DELETE;
        autoindex off;
    }

    # TEST DIRECTORY LISTING
    location /files {
        root ./www/files;
        methods GET;
        autoindex on;
    }

    # TEST REDIRECT INTERNAL
    location /old {
        return 301 /newpage;
    }

    location /newpage {
        root ./www;
        index newpage.html;
        methods GET;
    }

    # TEST REDIRECT EXTERNAL
    location /google {
        return 302 http://www.google.com;
    }

    # TEST POST UPLOAD
    location /upload {
        root ./www/upload;
        upload_path ./www/upload;
        methods POST GET;
        autoindex on;
    }

    # TEST DELETE FILE
    location /delete {
        root ./www/upload;
        methods DELETE;
    }

    # TEST CGI
    location /cgi {
        root ./www/cgi;
        methods GET POST;
        cgi_extensions .py /usr/bin/python3;
    }

    # FORCE ERROR
    location /error {
        return 500;
    }
}